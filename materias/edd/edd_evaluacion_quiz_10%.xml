<!-- PREGUNTA 8: Opción Múltiple - Operación Cola -->
<question type="multichoice">
  <name>
    <text>08. Operación Cola</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[¿Cómo se llama la operación para <strong>insertar</strong> un elemento en una Cola (Queue)?]]></text>
  </questiontext>
  <defaultgrade>2.0000000</defaultgrade>
  <shuffleanswers>1</shuffleanswers>
  <single>true</single>
  <answer fraction="100" format="moodle_auto_format">
    <text><![CDATA[Enqueue (Encolar)]]></text>
    <feedback format="html">
      <text><![CDATA[Correcto.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text><![CDATA[Dequeue (Desencolar)]]></text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Eso es para sacar elementos.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text><![CDATA[Push]]></text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Push se usa generalmente en Pilas.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text><![CDATA[Pop]]></text>
    <feedback format="html">
      <text><![CDATA[Incorrecto.]]></text>
    </feedback>
  </answer>
</question>

<!-- PREGUNTA 9: Verdadero/Falso - Cola Prioridad -->
<question type="truefalse">
  <name>
    <text>09. Cola de Prioridad</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[En una <strong>Cola de Prioridad</strong>, el elemento que sale primero es siempre el que lleva más tiempo esperando en la fila (el más antiguo).]]></text>
  </questiontext>
  <defaultgrade>2.0000000</defaultgrade>
  <answer fraction="0" format="moodle_auto_format">
    <text>true</text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Sale el elemento con mayor importancia/prioridad, independientemente de cuándo llegó.]]></text>
    </feedback>
  </answer>
  <answer fraction="100" format="moodle_auto_format">
    <text>false</text>
