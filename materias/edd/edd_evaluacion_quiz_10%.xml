<!-- PREGUNTA 1: Verdadero/Falso - Memoria Heap -->
<question type="truefalse">
  <name>
    <text>01. Memoria Heap</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[La memoria <strong>Heap</strong> (montón) es gestionada automáticamente por el compilador; las variables se eliminan solas al salir de la función.]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[Falso. El Heap es memoria dinámica gestionada manualmente por el programador (new/delete). La memoria automática es el Stack.]]></text>
  </generalfeedback>
  <defaultgrade>2.0000000</defaultgrade>
  <penalty>1.0000000</penalty>
  <hidden>0</hidden>
  <answer fraction="0" format="moodle_auto_format">
    <text>true</text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Esa es la definición del Stack.]]></text>
    </feedback>
  </answer>
  <answer fraction="100" format="moodle_auto_format">
    <text>false</text>
    <feedback format="html">
      <text><![CDATA[¡Correcto! El Heap requiere gestión manual.]]></text>
    </feedback>
  </answer>
</question>

<!-- PREGUNTA 2: Verdadero/Falso - Listas Circulares -->
<question type="truefalse">
  <name>
    <text>02. Listas Circulares</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[En una lista circular simple, el puntero 'siguiente' del último nodo apunta a <strong>nullptr</strong> (o NULL).]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[Falso. En una lista circular, el último nodo apunta de nuevo al primer nodo (Head).]]></text>
  </generalfeedback>
  <defaultgrade>2.0000000</defaultgrade>
  <answer fraction="0" format="moodle_auto_format">
    <text>true</text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Si apuntara a NULL sería una lista lineal simple.]]></text>
    </feedback>
  </answer>
  <answer fraction="100" format="moodle_auto_format">
    <text>false</text>
    <feedback format="html">
      <text><![CDATA[¡Correcto! Apunta al inicio de la lista.]]></text>
    </feedback>
  </answer>
</question>

<!-- PREGUNTA 3: Opción Múltiple - Complejidad Arreglos -->
<question type="multichoice">
  <name>
    <text>03. Complejidad Arreglos</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[¿Cuál es la complejidad temporal (Big O) para acceder a un elemento de un arreglo dado su índice (ej. arr[5])?]]></text>
  </questiontext>
  <defaultgrade>2.0000000</defaultgrade>
  <shuffleanswers>1</shuffleanswers>
  <single>true</single>
  <answer fraction="100" format="moodle_auto_format">
    <text><![CDATA[O(1)]]></text>
    <feedback format="html">
      <text><![CDATA[Correcto. Es acceso directo a memoria.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text><![CDATA[O(N)]]></text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Esto sería para una Lista Enlazada.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text><![CDATA[O(log N)]]></text>
    <feedback format="html">
      <text><![CDATA[Incorrecto.]]></text>
    </feedback>
  </answer>
</question>

<!-- PREGUNTA 4: Verdadero/Falso - Pilas LIFO -->
<question type="truefalse">
  <name>
    <text>04. Pilas LIFO</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[Una Pila (Stack) sigue el principio <strong>LIFO</strong> (Last In, First Out).]]></text>
  </questiontext>
  <defaultgrade>2.0000000</defaultgrade>
  <answer fraction="100" format="moodle_auto_format">
    <text>true</text>
    <feedback format="html">
      <text><![CDATA[Correcto. El último en entrar es el primero en salir.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text>false</text>
    <feedback format="html">
      <text><![CDATA[Incorrecto.]]></text>
    </feedback>
  </answer>
</question>

<!-- PREGUNTA 5: Verdadero/Falso - Fuga de Memoria -->
<question type="truefalse">
  <name>
    <text>05. Fuga de Memoria</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[Una <strong>fuga de memoria</strong> ocurre cuando reservamos memoria dinámica (por ejemplo, con <code>new</code>) pero olvidamos liberarla (por ejemplo, con <code>delete</code>).]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[Verdadero. Es un error común en C/C++ cuando no liberamos memoria asignada dinámicamente, lo que puede degradar el rendimiento o agotar la memoria.]]></text>
  </generalfeedback>
  <defaultgrade>2.0000000</defaultgrade>
  <penalty>1.0000000</penalty>
  <hidden>0</hidden>
  <answer fraction="100" format="moodle_auto_format">
    <text>true</text>
    <feedback format="html">
      <text><![CDATA[¡Correcto! Eso describe exactamente una fuga de memoria.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text>false</text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Si reservas memoria dinámica y no la liberas, estás provocando una fuga de memoria.]]></text>
    </feedback>
  </answer>
</question>

