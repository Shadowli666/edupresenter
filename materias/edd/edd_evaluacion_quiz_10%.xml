<!-- PREGUNTA 13: Opción Múltiple - Notación Postfija -->
<question type="multichoice">
  <name>
    <text>13. Notación RPN</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[Si usamos una Pila para evaluar la expresión postfija (RPN): <code>4 2 + 3 *</code>, ¿cuál es el resultado final?]]></text>
  </questiontext>
  <defaultgrade>2.0000000</defaultgrade>
  <shuffleanswers>1</shuffleanswers>
  <single>true</single>
  <answer fraction="100" format="moodle_auto_format">
    <text><![CDATA[18]]></text>
    <feedback format="html">
      <text><![CDATA[Correcto. (4+2)=6, luego 6*3=18.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text><![CDATA[10]]></text>
    <feedback format="html">
      <text><![CDATA[Incorrecto. Parece que evaluaste 4 + (2*3).]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="moodle_auto_format">
    <text><![CDATA[14]]></text>
  </answer>
</question>

